        "spoof_script_extensions",
        "spoof_identifier_status_allowed",
        "spoof_decimal_zero",
      ],
    },
    "wasm": {
      "exports": [
        "spoof_compare",
        "spoof_analyze",
        "spoof_batch_scan",
        "spoof_batch_scan_with_options",
        "spoof_validate_profile",
        "spoof_skeleton",
        "spoof_skeleton_case_folded",
        "spoof_get_restriction_info",
        "spoof_normalize_nfd",
        "spoof_unicode_script",
        "spoof_script_extensions",
        "spoof_identifier_status_allowed",
        "spoof_decimal_zero",
      ],
