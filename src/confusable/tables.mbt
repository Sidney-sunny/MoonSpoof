///|
pub fn binary_search_confusable(cp : Int) -> String? {
  let len = confusable_keys.length()
  let mut low = 0
  let mut high = len - 1
  while low <= high {
    let mid = (low + high) / 2
    let key = confusable_keys[mid]
    if key == cp {
      return Some(confusable_values[mid])
    } else if key < cp {
      low = mid + 1
    } else {
      high = mid - 1
    }
  }
  None
}
